@page "/ob/{id?}"
@model Bison.Razor.Pages.ObservationDetailsModel
@using Microsoft.AspNetCore.Identity
@using Bison.Infrastructure
@inject SignInManager<ApplicationUser> SignInManager
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}
<div>
    <h2> Observation details </h2>
    <ul id="messagelist" class="observations">
        <li>
            @if (Model.Observation != null)
            {
                <p>
                    @* Display the observation *@
                    <strong>
                        <a href="/ob/@Model.Observation.Id">@Model.Observation.Id</a>
                    </strong>
                    @Model.Observation.AuthorName
                    @Model.Observation.Text
                    <small>&mdash; @Model.Observation.TimeStamp</small>
                </p>
                <p>
                    <small>&mdash; @Model.Observation.TaxonName</small>
                </p>
                @if (Model.Observation.PhotoName is not null)
                {
                    <p>
                        <img src="/uploads/@Model.Observation.PhotoName" alt="Observation photo" />
                    </p>
                }
            }

            @* Display the proposals and comments *@
            <p>Proposals:</p>
            @if (!Model.Proposals.Any())
            {
                <em>There are no Proposals so far.</em>
            } else
            {
                @foreach (var ob in Model.Proposals)
                {   
                    if (ob.TaxonName is null)
                        continue;
                    <p>
                    <strong><a href="/obs/@ob.AuthorId">@ob.AuthorName</a></strong>
                    proposed <em>@ob.TaxonName</em>
                    @ob.Text
                    <small>&mdash; @ob.TimeStamp</small>
                    </p>
                }
            }
            <p>Comments:</p>
            @if (!Model.Comments.Any())
            {
                <em>There are no Comments so far.</em>
            } else
            {
                @foreach (var ob in Model.Comments)
                {
                <p>
                <strong><a href="/obs/@ob.AuthorId">@ob.AuthorName</a></strong>
                @ob.Text
                <small>&mdash; @ob.TimeStamp</small>
                </p>
                }
            }
        </li>
    </ul>

    @if (SignInManager.IsSignedIn(User))
    {
        <div class="observationbox">
            <h3>Propose a taxon</h3>
            <form method="post" asp-page-handler="Proposal" asp-route-id="@Model.Id">
                <p>
                    <label>asp-for="ProposalTaxonId">TaxonId</label>
                    <select asp-for="ProposalTaxonId" required style="max-width: 200px; width: 100%;">
                        <option value="">Choose a taxon</option>
                        @foreach (var taxon in Model.Taxons)
                        {
                            <option value="@taxon.Id">@taxon.VernacularName</option>
                        }
                    </select>
                </p>
                <input style="float: left" type="text" asp-for="ProposalText" maxlength="500" placeholder="Why do you think so? (optional)">
                <input type="submit" value="Propose">
                <span asp-validation-for="ProposalText"></span>
            </form>
        </div>
        <div class="observationbox">
            <h3>Add a comment</h3>
            <form method="post" asp-page-handler="Comment" asp-route-id="@Model.Id">
                <label asp for="CommentText">Comment</label>
                <input style="float: left" type="text" asp-for="CommentText" maxlength="500" required>
                <input type="submit" value="Comment">
                <span asp-validation-for="CommentText"></span>
            </form>
        </div>
    }
</div>
