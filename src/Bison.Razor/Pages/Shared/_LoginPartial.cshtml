@using Microsoft.AspNetCore.Identity
@using Bison.Infrastructure
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="navigation" role="navigation">
    <ul class="navbar-nav">
        @if (SignInManager.IsSignedIn(User))
        {
            var authorId = (await UserManager.GetUserAsync(User))?.AuthorId;

            <li class="nav-item">
                <a class="nav-link text-dark"
                   asp-area="Identity"
                   asp-page="/Account/Manage/Index"
                   title="Manage">
                    Hello @User.Identity?.Name!
                </a>
            </li>

            @if (authorId is not null)
            {
                <li class="nav-item">
                    <a class="nav-link text-dark" href="/obs/@authorId">My Observations</a>
                </li>
            }

            <li class="nav-item">
                <a class="nav-link text-dark" href="/">Public Observations</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" href="/new">New Observation</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" href="/BattlePass">Battle Pass</a>
            </li>

            <li class="nav-item">
                <form class="form-inline"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Page("/", new { area = "" })"
                      asp-area="Identity"
                      method="post">
                    <button class="nav-link btn btn-link text-dark" type="submit">
                        Logout [@(User.Identity?.Name)]
                    </button>
                </form>
            </li>
        }
        else
        {
            <li class="nav-item">
                <a class="nav-link text-dark" href="/">Public Observations</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark"
                   asp-area="Identity"
                   asp-page="/Account/Register">
                    Register
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark"
                   asp-area="Identity"
                   asp-page="/Account/Login">
                    Login
                </a>
            </li>
        }
    </ul>
</div>