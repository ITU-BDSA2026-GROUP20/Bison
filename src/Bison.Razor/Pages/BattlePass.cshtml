@page
@model Bison.Razor.Pages.BattlePassModel
@using Bison.Core.models.BattlePass
@{
    ViewData["Title"] = "Battle Pass";
    Layout = "Shared/_Layout";

    var tiers = Model.Items
        .GroupBy(i => i.ItemTier)
        .OrderBy(g => g.Key)
        .ToList();
}

@functions {
    static string Hex(uint argb) => "#" + (argb & 0x00FFFFFF).ToString("X6");
}

<style>
    .bp__track { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 6px; }

    .tier { display: flex; flex-direction: column; align-items: center; gap: 4px; }
    .tier__label { font-size: 12px; color: #555; }

    .cell {
        box-sizing: border-box;
        flex-shrink: 0;
        width: 84px;
        height: 96px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border: 1px solid;
        border-radius: 2px;
    }

    .cell--free  { background: #F0FAF9; border-color: #26776F; }
    .cell--paid  { background: #FAE4E4; border-color: #cc6e6e; }
    .cell--empty { background: transparent; border-color: #ccc; border-style: dashed; }

    .cell__num { font-size: 24px; color: #26776F; }
    .cell--paid .cell__num { color: #571010; }

    .cell__reward { font-size: 12px; color: #333; }

    .reskin { display: grid; grid-template-columns: 1fr 1fr; width: 40px; height: 24px; border: 1px solid #ccc; }
    .reskin span { display: block; }
</style>

<div>
    <h2>Bison Battle Pass</h2>

    <div class="bp__track">
        @foreach (var tier in tiers)
        {
            var free = tier.FirstOrDefault(i => !i.IsPaid);
            var paid = tier.FirstOrDefault(i => i.IsPaid);

            <div class="tier">
                <div class="cell @(free is null ? "cell--empty" : "cell--free")">
                    @if (free is not null)
                    {
                        <div class="cell__num">@tier.Key</div>
                        @if (free is UnlockDTO uf)
                        {
                            <div class="cell__reward">@uf.Feature</div>
                        }
                        else if (free is ReskinDTO rf)
                        {
                            <div class="reskin">
                                <span style="background:@Hex(rf.PrimaryColor)"></span>
                                <span style="background:@Hex(rf.SecondaryColor)"></span>
                                <span style="background:@Hex(rf.BackgroundColor)"></span>
                                <span style="background:@Hex(rf.TextColor)"></span>
                            </div>
                        }
                    }
                </div>

                <div class="cell @(paid is null ? "cell--empty" : "cell--paid")">
                    @if (paid is not null)
                    {
                        <div class="cell__num">@tier.Key</div>
                        @if (paid is UnlockDTO up)
                        {
                            <div class="cell__reward">@up.Feature</div>
                        }
                        else if (paid is ReskinDTO rp)
                        {
                            <div class="reskin">
                                <span style="background:@Hex(rp.PrimaryColor)"></span>
                                <span style="background:@Hex(rp.SecondaryColor)"></span>
                                <span style="background:@Hex(rp.BackgroundColor)"></span>
                                <span style="background:@Hex(rp.TextColor)"></span>
                            </div>
                        }
                    }
                </div>

                <div class="tier__label">T@(tier.Key)</div>
            </div>
        }
    </div>
</div>