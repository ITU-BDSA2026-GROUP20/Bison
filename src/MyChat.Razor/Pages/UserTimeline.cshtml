@page "/{author}/{pageNum:int:min(1)?}"
@model MyChat.Razor.Pages.UserTimelineModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <h2> @Model.Author's Observations </h2>

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var ob in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/@ob.Author">@ob.Author</a>
                        </strong>
                        @ob.Message
                        <small>&mdash; @ob.Timestamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no Observations so far.</em>
    }
</div>
