@page "/"
@model MyChat.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <h2> Public Timeline </h2>
    <form method="get">
        <select name="taxon", style="max-width: 200px; width: 100%;", onchange="this.form.submit()">
            <option value=""selected="@(Model.TaxonFilter == null)">No taxon filter</option>
            @foreach (var taxs in Model.UniTaxons)
            {
                <option value="@taxs.Id" selected="@(taxs.Id == Model.TaxonFilter)">@taxs.VernacularName</option>
            }
        </select>
    </form>
    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@obs.AuthorId">@obs.AuthorName</a>
                        </strong>
                        @obs.Text
                        <small>&mdash; @obs.TimeStamp</small>
                    </p>
                    <p>
                        <small>&mdash; @obs.TaxonName</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
</div>
